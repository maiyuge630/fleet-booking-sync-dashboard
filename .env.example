# Placeholders only. The demo (fleet-order-sync/demo/preview-server.cjs) needs
# none of these: it uses made-up orders and never contacts a booking platform.
# A real deployment keeps these values outside the repository (Cloudflare
# secrets and the phone's private app folder), never in a committed file.

# Cloudflare Worker that hosts the dashboard
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
WORKER_ORIGIN=https://your-worker.example.workers.dev
# Dashboard login settings (set as a Cloudflare secret, JSON with salted hashes)
FLEET_AUTH_CONFIG=your_dashboard_auth_config_here

# The Android phone that runs the sync service (adb serial number)
PHONE_DEVICE_SERIAL=YOUR_DEVICE_SERIAL

# Booking platform accounts. The phone signs in with the browser's own saved
# passwords; the code only checks which account is open, by these identifiers.
BOATAROUND_ACCOUNT_ID=your_boataround_account_id_here
CLICKANDBOAT_OWNER_NAME=your_clickandboat_profile_name_here
SAMBOAT_OWNER_ID=your_samboat_owner_id_here
MMK_SERVICE_ID=your_mmk_service_id_here
NAUSYS_USERNAME=your_nausys_username_here
# SHA-256 of each expected saved username (no passwords are stored anywhere)
SAVED_ACCOUNT_SHA256=your_sha256_here
